# Copy this file to .env in the same folder and fill in the empty values.
# Never commit the filled-in copy.

# Authorization service, at the address that came with the team key
LEASH_BASE_URL=https://leash-api-production.up.railway.app
TEAM_API_KEY=

# Language model provider, any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Time budgets in milliseconds, and the reserve kept for sending the answer
ENGINE_BUDGET_MS=6000
LLM_BUDGET_MS=2500
POST_RESERVE_MS=1500

# Worker. LEASH_MODE accepts live or offline, where offline serves the public purchases from an in-process copy of the platform.
# WORKER_AUTOSTART=true makes the worker poll from the start, for a run that someone else starts. Otherwise it polls while a run started here is open.
LEASH_MODE=live
WORKER_AUTOSTART=false

# Decision store and audit folder, empty for the defaults outputs/state/relay.sqlite3 and outputs/audit
STATE_DB_PATH=
AUDIT_FOLDER=

# Behavior switches
# GOAL_FULFILLED_ACTION accepts off, note or step_up, where step_up asks the customer before a second order of the one requested thing
# INJECTION_ACTION accepts step_up or decline
GOAL_FULFILLED_ACTION=step_up
INJECTION_ACTION=step_up

# Share of a limit by which a purchase may exceed it and still be put to the customer, from 0 to 1
OVERSHOOT_TOLERANCE_SHARE=0.10

# Send the trust score of every decision to the platform as three evidence items. false leaves them out of the answer only.
TRUST_SCORE_IN_EVIDENCE=true
